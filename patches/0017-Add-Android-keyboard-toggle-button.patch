+#if defined(__ANDROID__)
+static SDL_Rect android_keyboard_button_rect()
+{
+    SDL_Rect bounds{ 0, 0, WindowWidth, WindowHeight };
+    SDL_Rect safe_area;
+    bool has_safe_area = false;
+    bool unused_visible = false;
+    safe_area_inbox.read_frame( safe_area, has_safe_area, unused_visible );
+    if( has_safe_area && safe_area.w > 0 && safe_area.h > 0 ) {
+        bounds = surface_rect_to_window( safe_area );
+    } else if( SDL_GetWindowSafeArea( ::window.get(), &safe_area ) && safe_area.w > 0 && safe_area.h > 0 ) {
+        bounds = safe_area;
+    }
+    const int size = static_cast<int>( std::round( 44.0f * android_get_display_density() ) );
+    const int margin = static_cast<int>( std::round( 8.0f * android_get_display_density() ) );
+    return SDL_Rect{ bounds.x + margin, bounds.y + margin, size, size };
+}
+
+static bool android_keyboard_button_contains( const float x, const float y )
+{
+    const SDL_Rect button = android_keyboard_button_rect();
+    return x >= button.x && x < button.x + button.w && y >= button.y && y < button.y + button.h;
+}
+
+static void draw_android_keyboard_button()
+{
+    const SDL_Rect button = android_keyboard_button_rect();
+    if( button.w <= 0 || button.h <= 0 ) {
+        return;
+    }
+
+    const bool active = IsTextInputActive( ::window.get() );
+    const bool selected = active || is_android_keyboard_button_touch;
+    const float opacity = get_option<int>( "ANDROID_VIRTUAL_JOYSTICK_OPACITY" ) * 0.01f;
+    const Uint8 background_alpha = static_cast<Uint8>( std::max( 0.35f,
+                                             std::min( 1.0f, opacity * 1.8f ) ) * 255.0f );
+    const Uint8 icon_color = selected ? 0 : 255;
+    const int unit = std::max( 1, button.w / 22 );
+    const int icon_width = unit * 14;
+    const int icon_height = unit * 10;
+    const int icon_x = button.x + ( button.w - icon_width ) / 2;
+    const int icon_y = button.y + ( button.h - icon_height ) / 2;
+
+    SetRenderDrawBlendMode( renderer, SDL_BLENDMODE_BLEND );
+    SetRenderDrawColor( renderer, selected ? 255 : 0, selected ? 255 : 0, selected ? 255 : 0,
+                        background_alpha );
+    RenderFillRect( renderer, &button );
+    SetRenderDrawColor( renderer, icon_color, icon_color, icon_color, 255 );
+
+    const SDL_Rect outline_top{ icon_x, icon_y, icon_width, unit };
+    const SDL_Rect outline_bottom{ icon_x, icon_y + icon_height - unit, icon_width, unit };
+    const SDL_Rect outline_left{ icon_x, icon_y, unit, icon_height };
+    const SDL_Rect outline_right{ icon_x + icon_width - unit, icon_y, unit, icon_height };
+    RenderFillRect( renderer, &outline_top );
+    RenderFillRect( renderer, &outline_bottom );
+    RenderFillRect( renderer, &outline_left );
+    RenderFillRect( renderer, &outline_right );
+
+    const int key_size = unit;
+    for( int row = 0; row < 2; ++row ) {
+        for( int column = 0; column < 5; ++column ) {
+            const SDL_Rect key{ icon_x + unit * 2 + column * unit * 2,
+                                icon_y + unit * 2 + row * unit * 2, key_size, key_size };
+            RenderFillRect( renderer, &key );
+        }
+    }
+    const SDL_Rect spacebar{ icon_x + unit * 5, icon_y + icon_height - unit * 3, unit * 4, unit };
+    RenderFillRect( renderer, &spacebar );
+    SetRenderDrawBlendMode( renderer, SDL_BLENDMODE_NONE );
+}
+#endif
 #endif
 
